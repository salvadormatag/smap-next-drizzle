{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "isolatedModules": true
  },
  "include": [
    "src",
    "global.d.ts"
  ],
  "exports": {
    "./navigator": {
      "types": "./dist/navigator/index.d.ts",
      "import": "./dist/navigator/index.mjs",
      "require": "./dist/navigator/index.js"
    },
    "./instants": {
      "types": "./dist/instants/index.d.ts",
      "import": "./dist/instants/index.mjs",
      "require": "./dist/instants/index.js"
    },
    "./oauth": {
      "types": "./dist/oauth/index.d.ts",
      "import": "./dist/oauth/index.mjs",
      "require": "./dist/oauth/index.js"
    }
  }
}
