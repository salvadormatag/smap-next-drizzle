{
  "name": "smap-next-drizzle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preinstall": "node ./scripts/check-pnpm.js",
    "db:setup": "pnpm run db:drop && pnpm run db:start",
    "db:drop": "tsx src/infrastructure/orm/tools/dropSchema.ts",
    "db:start": "tsx src/infrastructure/orm/build/setup.ts",
    "cypress:grafic": "cypress open",
    "cypress": "cypress run",
    "smap": "tsx src/lab/tests/smap.ts",
    "web:dev": "next dev --webpack",
    "sdk:dev": "pnpm --filter @smap-dev/sdk dev",
    "sdk": "concurrently \"pnpm sdk:dev\" \"pnpm web:dev\""
  },
  "dependencies": {
    "@smap-dev/sdk": "workspace:*",
    "@tiptap/core": "^3.11.1",
    "@tiptap/extension-code-block-lowlight": "^3.11.1",
    "@tiptap/extension-document": "^3.11.1",
    "@tiptap/extension-heading": "^3.11.1",
    "@tiptap/extension-highlight": "^3.11.1",
    "@tiptap/extension-horizontal-rule": "^3.11.1",
    "@tiptap/extension-image": "^3.11.1",
    "@tiptap/extension-list": "^3.11.1",
    "@tiptap/extension-paragraph": "^3.11.1",
    "@tiptap/extension-strike": "^3.11.1",
    "@tiptap/extension-subscript": "^3.11.1",
    "@tiptap/extension-superscript": "^3.11.1",
    "@tiptap/extension-text": "^3.11.1",
    "@tiptap/extension-text-align": "^3.11.1",
    "@tiptap/extension-typography": "^3.11.1",
    "@tiptap/extensions": "^3.11.1",
    "@tiptap/pm": "^3.11.1",
    "@tiptap/react": "^3.11.1",
    "@tiptap/starter-kit": "^3.11.1",
    "argon2": "^0.44.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "bluebird": "^3.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "drizzle": "^1.4.0",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "lodash-es": "^4.17.21",
    "lodash.throttle": "^4.1.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.554.0",
    "next": "16.2.4",
    "pg": "^8.16.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-calendar": "^6.0.1",
    "react-dom": "19.2.5",
    "react-hotkeys-hook": "^5.2.1",
    "slugify": "^1.6.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^23.2.1",
    "@cypress/webpack-preprocessor": "^7.0.2",
    "@esbuild-plugins/node-modules-polyfill": "^0.2.2",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/lodash-es": "^4.17.12",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.14",
