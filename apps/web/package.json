    "drizzle-kit": "^0.31.7",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.0.0",
    "ts-loader": "^9.5.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
